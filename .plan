**文件**: `subs-check/checker/pipeline.go`
**状态**: ✅ 已完成 (2026-07-07)
```go
// 媒体检测：检测所有启用的平台
for _, plat := range config.GlobalConfig.Platforms {
    switch plat {
    case "openai":
        item.Openai, item.OpenaiWeb = CheckOpenAI(mediaCtx, si.client.Client)
    case "youtube":
        if yt, err := CheckYoutube(mediaCtx, si.client.Client); err == nil {
            item.Youtube = yt
